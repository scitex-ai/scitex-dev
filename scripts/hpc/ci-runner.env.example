# Env contract for spartan-ci-runner-wrapper.v2.sh (the durable / option-B
# wrapper). When the SLURM job's main process IS the wrapper (no
# `srun --overlap` intermediate), it has to read GH_TOKEN/GH_REPO/RUNNER_*
# itself before exec'ing launcher.sh.
#
# Path on spartan-bm159: ~/.scitex/dev/ci-runner.env  (chmod 0600).
# GITIGNORED, never committed.
#
# Cross-reference: the values here MUST match the corresponding keys in
# ~/.scitex/dev/ci-runner.yaml so option-A (srun-overlap-launch.sh, which
# reads the yaml) and option-B (this env file) point at the same runner
# identity, repo, and storage.

# Classic PAT, scopes: repo + workflow + actions:variables:write.
# (Same value that ~/.bashrc or systemd-user keeps as $SCITEX_DEV_GH_PAT
# on the operator host; copy it over for the runner host.)
export GH_TOKEN="<TODO_paste_classic_pat>"

# Target repo for the proof-of-life pilot. Start small (scitex-dev only),
# widen via `scitex-dev ci runner register <other-repo>` once green.
export GH_REPO="ywatanabe1989/scitex-dev"

# Stable, single runner; bump suffix when re-keying.
export RUNNER_NAME="scitex-ci-runner-01"
export RUNNER_LABELS="self-hosted,scitex-ci"

# Persistent project storage. NOT $HOME (quota) and NOT scratch (purged).
export RUNNER_HOME="<TODO_/absolute/path/on/punim2354/github_runner>"

# Optional pin override. Default (in launcher.sh) is 2.328.0 — keep aligned
# with scripts/hpc/install-runner.sh's pinned digest.
# export RUNNER_VERSION="2.328.0"
