# Selected scitex-dev environment settings, not a complete inventory.
#
# Export desired values in the process environment launching Dev. Copying this
# file to .env alone does not configure load_config() or show-config: those
# readers do not source .env. A CLI flag overrides an environment value only
# when its consumer implements that connection.
#
# See src/scitex_dev/_skills/scitex-dev/20_env-vars.md for owning readers and
# limitations, and 12_config.md for YAML selection and managed-state precedence.

# --- YAML and machine-managed package preferences ----------------------

# _core/config.py: explicit Python config_path wins over this YAML path.
# If unset/empty, select existing project .scitex/dev/config.yaml, then the
# user path (normally ~/.scitex/dev/config.yaml); legacy user dev_config.yaml
# is used only when the preferred default is absent. A path need not exist.
# SCITEX_DEV_CONFIG=

# _core/_knobs.py: JSON package switches overlay YAML; this selects the file.
# Default shared path: ~/.scitex/dev/runtime/knob-state.json, with an existing
# project-local counterpart preferred by the shared resolver.
# SCITEX_DEV_KNOB_STATE=

# Shared scitex-config local-state resolver: relocate the user .scitex root.
# SCITEX_DIR=~/.scitex

# _core/config.py: nonempty CSV selections replace enablement flags for the
# configured rows. They do not discover/create hosts or GitHub remotes.
# SCITEX_DEV_HOSTS=host-a,host-b
# SCITEX_DEV_GITHUB_REMOTES=example-org

# --- Legacy skill export -----------------------------------------------

# _ecosystem/_skills/skills.py::_get_default_export_dest: legacy export only.
# An explicit export destination wins. This does not relocate skills install.
# SCITEX_DEV_SKILLS_DEFAULT_EXPORT_DIR=~/.claude/skills/scitex

# --- Legacy HPC test helpers -------------------------------------------

# test_runner.py::_get_hpc_config: explicit TestConfig field, then environment,
# then defaults shown below. These are not Dev YAML settings or proof of an
# admitted host/job. Submit, poll and fetch consumers differ; see guide43.
# SCITEX_DEV_TEST_HOST=spartan
# SCITEX_DEV_TEST_PARTITION=sapphire
# SCITEX_DEV_TEST_CPUS=16
# SCITEX_DEV_TEST_MEM=128G
# SCITEX_DEV_TEST_TIME=00:20:00
# SCITEX_DEV_TEST_REMOTE_BASE=~/proj
