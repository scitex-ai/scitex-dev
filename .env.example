# scitex-dev environment variables
#
# Copy this file to `.env` (gitignored) and edit values for your setup.
# CLI flags always override env vars when both are given. Variables
# follow the SciTeX ecosystem convention: SCITEX_<MODULE>_<NAME>.
#
# Local state (per the SciTeX local-state convention) is read from:
#   ~/.scitex/dev/                 user-global config + cache
#   <proj-root>/.scitex/dev/       project-local overrides (preferred)

# --- Paths / config ----------------------------------------------------

# Path to the scitex-dev YAML config (default: bundled).
# SCITEX_DEV_CONFIG=

# Path to an env-file sourced at CLI startup.
# SCITEX_DEV_ENV_SRC=

# Default target when `scitex dev skills export --link`.
# SCITEX_DEV_SKILLS_DEFAULT_EXPORT_DIR=~/.claude/skills/scitex

# Base SciTeX data dir (ecosystem-wide).
# SCITEX_DIR=~/.scitex

# --- Ecosystem audit ---------------------------------------------------

# Extra GitHub org/user names to sync via `ecosystem pull/sync` (CSV).
# SCITEX_DEV_GITHUB_REMOTES=ywatanabe1989

# SSH hosts for ecosystem-wide operations (CSV).
# SCITEX_DEV_HOSTS=

# Claude-account slugs used by the agentic test harness (CSV).
# SCITEX_DEV_CLAUDE_ACCOUNTS=

# Override for package-category taxonomy (CSV).
# SCITEX_CATEGORIES=

# Path to upstream/downstream rules YAML (default: bundled).
# SCITEX_UPSTREAM_AND_DOWNSTREAM_RULES=

# --- Agentic / HPC test harness ----------------------------------------

# Backend for agentic tests: docker / apptainer / local.
# SCITEX_DEV_AGENTIC_BACKEND=docker

# Docker image for the agentic harness (default: bundled tag).
# SCITEX_DEV_AGENTIC_DOCKER_IMAGE=

# HPC host for `scitex dev test hpc`.
# SCITEX_DEV_TEST_HOST=

# SLURM partition.
# SCITEX_DEV_TEST_PARTITION=

# CPUs per task.
# SCITEX_DEV_TEST_CPUS=4

# Memory per task.
# SCITEX_DEV_TEST_MEM=8G

# Wall-clock limit (HH:MM:SS).
# SCITEX_DEV_TEST_TIME=01:00:00

# Remote base dir for staged test sources.
# SCITEX_DEV_TEST_REMOTE_BASE=~/scratch/scitex-test
