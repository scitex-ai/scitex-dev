# scitex-dev CI runner container (CPU) — Apptainer recipe (public SSoT).
#
# Purpose: the LEAN, read-only BASE IMAGE the self-hosted Spartan CPU runner
# apptainer-exec's — exactly like GitHub's hosted-runner image. It carries the
# common toolchain (Python 3.11/3.12/3.13 + uv + system libs + scitex-dev for
# audit tooling) and NOTHING package-specific. Per-package dependencies are
# NOT baked here; they live in a per-workflow, cached, WRITABLE overlay keyed
# on (python-version, sha256(pyproject.toml)) — see run-in-sif.sh. Steady
# state: this base is reused unchanged; only a workflow's overlay rebuilds
# when that package's deps change. Rebuild this base only when the TOOLCHAIN
# (pythons / uv / system libs / scitex-dev) changes.
#
# Two-layer model (GitHub-runner-faithful):
#   LAYER 1 (here)   read-only base SIF      == github's runner image
#   LAYER 2 (overlay) per-workflow deps      == per-job disk + actions/cache
#   LAYER 0 (uv-cache) shared GPFS wheel cache == github's pip/uv cache
#
# Build (canonical — versioned via scitex-container, on a RUNNING compute
# node; never the login node, never sbatch-and-wait):
#   scitex-container apptainer build ci-cpu -o ~/.scitex/dev/containers
# Raw fallback (same effect):
#   apptainer build ci-cpu.sif ci-cpu.def
#
# Run contract (the workflow): each matrix job execs the read-only base WITH
# its keyed overlay; deps come from a FRESH venv inside that overlay (created
# as the runner user — never the root-owned /opt), installed on cache-MISS and
# reused on cache-HIT:
#   apptainer exec --overlay <keyed-overlay> <sif> ...   (see run-in-sif.sh)
#
# Design notes (vs the heavier agent base.def): no node/rust/claude-sdk —
# CI inside the SIF runs pytest only (checkout/codecov run on the host
# runner). Three Python versions for the required pytest matrix.

Bootstrap: docker
From: ubuntu:24.04

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # System libs: build-essential/pkg-config/libffi/libssl for any
    # source-built wheel; libglib2.0-0 is REQUIRED by scitex.io (without
    # it import silently falls back to "minimal mode" — exactly the kind
    # of silent degradation we forbid). fd for the audit-conformance test.
    #
    # cron + systemd are TEST-ENVIRONMENT tools, not runtime services here:
    # scitex-dev MANAGES crontab + a systemd user unit (`ecosystem cron`,
    # `ecosystem up`), and its tests shell out to `crontab -l` / gate on
    # `shutil.which("systemctl")`. A bare container has neither, so those
    # tests fail with "'crontab' not found" / silently skip the supervisor
    # enable path. Installing the BINARIES (systemd is never PID1 here) makes
    # the CI container match a real SciTeX host — honest, not a mock.
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git locales \
        build-essential pkg-config libffi-dev libssl-dev libglib2.0-0 \
        fd-find ripgrep cron systemd
    locale-gen en_US.UTF-8
    # Debian ships fd as fdfind; the audit helper + muscle memory want `fd`.
    ln -sf "$(command -v fdfind)" /usr/local/bin/fd
    rm -rf /var/lib/apt/lists/*

    # uv (Astral): manages the Python toolchain + fast installs.
    # The installer lands uv in /root/.local/bin (root-only, 0700) — a SYMLINK
    # there is unreadable by the non-root runtime user, so COPY the real
    # binaries to /usr/local/bin (world-exec) for both %post and runtime.
    curl -LsSf https://astral.sh/uv/install.sh | sh
    cp -f /root/.local/bin/uv /usr/local/bin/uv
    cp -f /root/.local/bin/uvx /usr/local/bin/uvx
    chmod 0755 /usr/local/bin/uv /usr/local/bin/uvx
    export PATH=/usr/local/bin:$PATH
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python

    # Pre-stage the three matrix Python versions. These baked interpreters
    # under /opt/uv-python are what `uv venv --python <V>` discovers at runtime
    # when run-in-sif.sh builds each workflow's FRESH overlay venv — so the
    # cache-MISS path needs no network interpreter download.
    #
    # scitex-dev[all,dev] is baked into a per-version /opt/venv-<V> as the only
    # package in the base (operator: "+ scitex-dev for audit tooling"). It is
    # NOT used to run the package-under-test (that runs from the overlay's fresh
    # editable install) — it is here so the brand-wide audit tooling, the
    # `scitex-dev` console script, and the linter/auditor entry points are
    # available without a per-job install. NO other package deps are baked:
    # zarr / pyarrow / pypdf / gitpython / torch / … come from the per-workflow
    # overlay (run-in-sif.sh), exactly like a hosted runner installing them per
    # job. This keeps the base LEAN and lets each repo's deps version
    # independently of the image.
    #
    # The permission lesson that drove the overlay model: /opt below is
    # root-owned, so a runtime `uv pip install -e .` INTO /opt/venv-<V> hits
    # `Permission denied` for the non-root runner (a dir overlay can't copy-up
    # root-owned site-packages; an ext3 overlay needs fakeroot we don't have).
    # run-in-sif.sh therefore never writes /opt — it creates a NEW venv at an
    # overlay-owned path (/ci/venv) instead.
    for V in 3.11 3.12 3.13; do
        uv python install "$V"
        uv venv --python "$V" "/opt/venv-$V"
        uv pip install --python "/opt/venv-$V/bin/python" "scitex-dev[all,dev]"
        # pytest-timeout is in develop's [dev] but may lag in PyPI's
        # published [dev] extra. Bake it so the audit venv has the full
        # toolchain; the overlay venv installs its own copy too.
        uv pip install --python "/opt/venv-$V/bin/python" pytest-timeout
    done

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    export PATH=/usr/local/bin:$PATH

%labels
    org.scitex.layer ci-cpu
    org.scitex.runtime apptainer
    org.scitex.contains "python3.11 python3.12 python3.13 uv fd ripgrep cron systemd + scitex-dev[all,dev]"

%help
    scitex-dev CI runner image (CPU) — the LEAN, read-only BASE (== github's
    hosted-runner image). Reused by the self-hosted Spartan runner:
        apptainer exec --overlay <keyed-overlay> <sif> ...
    via .github/ci/run-in-sif.sh <ver>. Per-package deps are NOT baked here;
    they live in a per-workflow cached overlay keyed on (py-version,
    sha256(pyproject.toml)), installed into a FRESH overlay-owned venv
    (/ci/venv) on cache-MISS and reused on cache-HIT. The baked
    scitex-dev[all,dev] is the audit-tooling base only. Rebuild this image
    only when the toolchain (pythons / uv / system libs / scitex-dev)
    changes — NOT when a package's deps change (that re-keys its overlay).
