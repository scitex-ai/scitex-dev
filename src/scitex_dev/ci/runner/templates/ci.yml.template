# Reusable scitex-ci self-hosted runner workflow (scitex-dev ships this).
# A repo onboards by copying this verbatim into .github/workflows/ci.yml AND
# copying run-in-sif.sh into .github/ci/run-in-sif.sh. Nothing repo-specific
# lives here — the package + its deps + test paths are read from the checkout.
#
# Model (GitHub-runner-faithful — see run-in-sif.sh for the full contract):
#  * runs-on driven by repo Actions Variable CI_RUNS_ON. Default
#    '["self-hosted","scitex-ci"]'. Watchdog auto-flips to '"ubuntu-latest"'
#    on runner-offline (manual override via `scitex-dev ci runner use ...`).
#  * Self-hosted path: the LEAN read-only base SIF (LAYER 1) + a per-workflow
#    WRITABLE overlay (LAYER 2) keyed on (python-version, sha256(pyproject)).
#    Deps install into a FRESH overlay-owned venv on cache-MISS, are REUSED on
#    cache-HIT (no install) — exactly like actions/cache around pip. A shared
#    GPFS uv wheel cache (LAYER 0) keeps the MISS path fast. All of this lives
#    in run-in-sif.sh; the workflow just sets the env + calls it.
#
# Repo Actions Variables consumed (set once per repo; carry NO HPC paths in
# this YAML):
#    SCITEX_CI_APPTAINER     path to apptainer
#    SCITEX_CI_SIF           path to the read-only base SIF
#    SCITEX_CI_OVERLAY_ROOT  GPFS dir holding keyed overlays
#    SCITEX_CI_UV_CACHE      GPFS shared uv wheel cache

name: ci

on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened]
  workflow_dispatch:

# Sec: repo Settings → Actions → "Require approval for all outside
# collaborators". Self-hosted runners NEVER auto-run untrusted fork code.

jobs:
  pytest:
    name: pytest-py${{ matrix.python-version }}
    runs-on: ${{ fromJSON(vars.CI_RUNS_ON || '["self-hosted","scitex-ci"]') }}
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@v4

      # Hosted fallback path — only fires when watchdog has flipped to
      # ubuntu-latest, or on a fresh repo with vars.CI_RUNS_ON unset.
      - if: runner.environment == 'github-hosted'
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - if: runner.environment == 'github-hosted'
        run: |
          python -m pip install --upgrade pip pytest pytest-xdist
          python -m pip install -e ".[all,dev]" || python -m pip install -e ".[dev]" || python -m pip install -e .
          python -m pytest tests/ -n auto --tb=short

      # Self-hosted in-SIF path — keyed-overlay, github-runner-faithful.
      # ALL logic (key derivation, cache HIT/MISS, fresh-venv install, prune,
      # xdist sizing, pytest) is in run-in-sif.sh — the GOLD template.
      - if: runner.environment == 'self-hosted'
        env:
          APPTAINER: ${{ vars.SCITEX_CI_APPTAINER }}
          SIF: ${{ vars.SCITEX_CI_SIF }}
          CI_OVERLAY_ROOT: ${{ vars.SCITEX_CI_OVERLAY_ROOT }}
          UV_CACHE_DIR: ${{ vars.SCITEX_CI_UV_CACHE }}
        run: bash .github/ci/run-in-sif.sh "${{ matrix.python-version }}"
